# Copy to .env.local and fill in. NEVER commit .env.local.
# Phase 1: none of these are required — the site builds and runs without them.

# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# Random string (min. 16 chars) protecting /api/cron/* routes
CRON_SECRET=

# Dashboard design preview (Phase 5A). LOCAL ONLY — NEVER set this on Vercel.
# DASHBOARD_PREVIEW=local

# Protected client demo (Phase 5A.2) — set ONLY in Vercel → Environment Variables →
# Preview, restricted to the Git branch `client-demo`. NEVER for Production.
# Values are secrets: never commit them. See docs/CLIENT_DEMO.md.
# DEMO_ENVIRONMENT=client-demo
# DEMO_ACCESS_PASSWORD=        (min. 12 chars, random)
# DEMO_SESSION_SECRET=         (min. 32 chars, random)
# DEMO_SESSION_HOURS=12
